[Unit]
Description=Rescu sim server (REST + WebSocket + MCP, :4000)
After=rescu-validator.service
Requires=rescu-validator.service

[Service]
User=rescu
WorkingDirectory=/opt/rescu/apps/server
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/bin/env pnpm start
Restart=on-failure
RestartSec=3
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
