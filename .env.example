# Copy to .env and fill in. Never commit .env.

# --- Solana (own solana-test-validator; on Vultr in production) ---
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_WS_URL=ws://127.0.0.1:8900
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
# Public HTTPS proxy to the validator, used for Solana Explorer custom-cluster links
PUBLIC_RPC_URL=https://rpc.rescu.tech
RESCU_PROGRAM_ID=GrxgRShVcGaESyztvHHtaCF8YMXVhK3Wq7AesbQCaLy5
# Keypairs live outside the repo
ADMIN_KEYPAIR=~/.config/rescu/admin.json
ORACLE_KEYPAIR=~/.config/rescu/oracle.json
RELAYER_KEYPAIR=~/.config/rescu/relayer.json
AGENT_KEYPAIR=~/.config/rescu/agent.json
# 32-byte hex; simulated resident and merchant wallets are derived from it
SIM_WALLET_SEED=
# Live network (apps/server): households on-chain per run (a sample of the full-scale allocation),
# payment transactions per second the sim may send, fee payers the payments rotate through
SIM_HOUSEHOLDS=20000
SIM_MERCHANTS_MAX=500
SIM_MAX_TPS=400
SIM_FEE_PAYERS=8
SIM_DEFAULT_STORM=helene-2024
# Sim server port (web stays on 3000)
PORT=4000

# --- Grok (xAI) ---
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_AGENT=grok-4.20-non-reasoning
XAI_MODEL_ORACLE=grok-4.20-non-reasoning
# Server-side kill switch; total credits are $25
XAI_SPEND_LIMIT_USD=20

# --- Tiger Data ---
TIGER_DATABASE_URL=postgres://user:pass@host:port/tsdb?sslmode=require

# --- Web / deploy ---
PUBLIC_DOMAIN=rescu.tech
VULTR_SERVER_IP=
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Codex + offline data generation only (never used in product features)
OPENAI_API_KEY=
