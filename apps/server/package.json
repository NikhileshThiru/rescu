{
  "name": "@rescu/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sim engine + chain runner + Tiger writer + WebSocket for the Command Center.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "sim": "tsx src/headless.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@rescu/aid-model": "workspace:*",
    "@rescu/chain": "workspace:*",
    "@rescu/live": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "fastify": "5.12.5",
    "h3-js": "4.5.0",
    "postgres": "3.4.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
